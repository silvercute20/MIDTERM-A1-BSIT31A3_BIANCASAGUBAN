@model Library_Management.Models.BookCopyViewModel

<div class="mb-3">
    <label class="form-label">Source</label>
    <input type="text" class="form-control" asp-for="Source" id="copySource" />
</div>
<div class="mb-3">
    <label class="form-label">Condition</label>
    <input type="text" class="form-control" asp-for="Condition" id="copyCondition" />
</div>
<div class="mb-3">
    <label class="form-label">Added Date</label>
    <input type="date" class="form-control" asp-for="AddedDate" id="copyDate" />
</div>
<button type="button" class="btn btn-primary" id="addCopyBtn">Add Copy</button>
