@model Library_Management.Models.EditAuthorViewModel

<div class="modal-header">
    <h5 class="modal-title">@((Model.AuthorId == Guid.Empty) ? "Add Author" : "Edit Author")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="authorForm" method="post" asp-action="@(Model.AuthorId == Guid.Empty ? "Add" : "Edit")">
    <input type="hidden" asp-for="AuthorId" />
    <div class="modal-body">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Biography" class="form-label">Biography</label>
            <textarea asp-for="Biography" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="BirthDate" class="form-label">Birth Date</label>
            <input asp-for="BirthDate" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="ProfileImageUrl" class="form-label">Profile Image URL</label>
            <input asp-for="ProfileImageUrl" class="form-control" />
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
