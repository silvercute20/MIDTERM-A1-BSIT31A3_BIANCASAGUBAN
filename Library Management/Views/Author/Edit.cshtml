@model Library_Management.Models.EditAuthorViewModel

@{
    ViewData["Title"] = "Edit Author";
}

<h1 class="mb-4 fw-bold">Edit Author</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="AuthorId" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Biography" class="form-label"></label>
        <textarea asp-for="Biography" class="form-control"></textarea>
        <span asp-validation-for="Biography" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BirthDate" class="form-label"></label>
        <input asp-for="BirthDate" type="date" class="form-control" />
        <span asp-validation-for="BirthDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProfileImageUrl" class="form-label"></label>
        <input asp-for="ProfileImageUrl" class="form-control" />
        <span asp-validation-for="ProfileImageUrl" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


